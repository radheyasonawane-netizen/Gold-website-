# Server-side only. Never expose these to the browser.
# Groww Trade API access token (Groww: Settings > Trading APIs > Generate API keys > Access Token). Expires daily at 6:00 AM.
GROWW_ACCESS_TOKEN=
# Optional: pin a contract instead of auto-selecting the nearest Gold Ten future
GROWW_GOLDTEN_SYMBOL=
GROWW_GOLDTEN_EXPIRY=
